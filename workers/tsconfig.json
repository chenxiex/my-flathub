{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2022"],
        "types": ["./worker-configuration.d.ts", "@cloudflare/vitest-plugin/types"],
        "allowImportingTsExtensions": true,
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true
