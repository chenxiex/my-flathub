{
    "name": "my-flathub-pr-preview",
    "private": true,
    "type": "module",
    "scripts": {
        "generate-types": "wrangler types --config wrangler.toml",
        "typecheck": "wrangler types --config wrangler.toml && tsc --noEmit",
        "test": "vitest run",
        "build": "wrangler deploy --dry-run --outdir dist",
        "deploy": "wrangler deploy --config wrangler.toml"
    },
    "devDependencies": {
        "@cloudflare/vitest-plugin": "1.1.10",
        "@msw/cloudflare": "0.0.1",
        "msw": "2.15.0",
        "typescript": "6.0.3",
        "vitest": "4.1.11",
        "wrangler": "4.132.0"
    }
}
